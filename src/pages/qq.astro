---
import Layout from "../layouts/Layout.astro";
---

<Layout title="联系我 - QQ">
  <!-- 使用 flex 居中整个内容 -->
  <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 75vh; padding: 2rem; text-align: center;">
    
    <h1 style="font-size: 2rem; margin-bottom: 1rem; font-weight: bold;">扫码加我 QQ 好友</h1>
    
    <!-- 图片容器 -->
    <div style="margin-bottom: 2rem; border-radius: 1rem; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.2); background-color: #2b2b2b; padding: 10px;">
      <!-- 这里的 max-width: 100% 保证手机上不会超出屏幕，max-height: 60vh 保证电脑上不会太长 -->
      <img 
        src="/qq.png" 
        alt="QQ二维码" 
        style="max-width: 100%; max-height: 60vh; width: auto; height: auto; display: block; border-radius: 0.5rem;" 
      />
    </div>

    <div style="margin-top: 1rem;">
      <a href="/" style="color: var(--primary); text-decoration: underline; font-weight: bold; font-size: 1.1rem;">← 返回首页</a>
    </div>
    
  </div>
</Layout>